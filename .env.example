# Synthetic, disposable credentials for the drill. Copy to .env before running
# (make up does this automatically). Nothing here is a real secret.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=drill_primary_pw
POSTGRES_DB=pitr_drill

# Repository encryption passphrase, handed to the pgBackRest clients through the
# environment and never written into committed config. This synthetic value keeps
# the drill reproducible; in real use the owner generates and holds it
# (openssl rand -base64 48) and the repository host never receives it.
PGBACKREST_REPO1_CIPHER_PASS=TkJjgeOUoo3KVebBzswNeKxPsnVw1WigOlYRdq1bTZy+3a7Doz2gvrgofpktvAk9
